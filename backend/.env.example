# Application
APP_NAME=InterviewSage AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./interviewsage.db

# Security — REQUIRED: Cryptographically secure key (minimum 32 characters)
# Generate via `openssl rand -hex 32` or python `secrets.token_hex(32)`
SECRET_KEY=GENERATE_YOUR_OWN_SECURE_SECRET_KEY_MIN_32_CHARS_LONG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:0.6b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2000
LLM_FALLBACK_MODEL=qwen3:0.6b

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
