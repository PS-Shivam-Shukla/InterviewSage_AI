# ==============================================================================
# InterviewSage AI — Enterprise Production Environment Configuration Template
# COPY THIS FILE TO .env.production OR SET IN YOUR SECURE ENVIRONMENT MANAGEMENT PLATFORM
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
APP_NAME="InterviewSage AI"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Production Database (PostgreSQL Highly Recommended)
# ------------------------------------------------------------------------------
# Example: postgresql://user:password@pg-primary.internal:5432/interviewsage_prod
DATABASE_URL="postgresql://user:password@localhost:5432/interviewsage"

# ------------------------------------------------------------------------------
# 3. Cryptographic Security & JWT Tokens (MANDATORY SECURE KEY)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ------------------------------------------------------------------------------
SECRET_KEY="REPLACE_WITH_HIGH_ENTROPY_64_CHAR_SECRET_KEY_REQUIRED_FOR_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 Days

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Comma-separated exact domains, no wildcards)
# ------------------------------------------------------------------------------
CORS_ORIGINS="https://app.interviewsage.ai,https://admin.interviewsage.ai"

# ------------------------------------------------------------------------------
# 5. LLM Engine & Provider Configuration
# Supported providers: ollama (local), openai (cloud), groq (cloud)
# ------------------------------------------------------------------------------
LLM_PROVIDER="ollama"
LLM_MODEL_NAME="qwen3:instruct"
OLLAMA_BASE_URL="http://localhost:11434"
LLM_API_KEY="local-ollama-key"
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2000
LLM_FALLBACK_MODEL="qwen2.5:latest"

# ------------------------------------------------------------------------------
# 6. Speech & Voice Engine Configuration
# ------------------------------------------------------------------------------
WHISPER_MODEL="base"
WHISPER_DEVICE="cpu"
TTS_PROVIDER="kokoro"
VOICE="en"
VOICE_SPEED=1.0
STREAM_AUDIO=true
AUDIO_SAMPLE_RATE=16000

# ------------------------------------------------------------------------------
# 7. File Storage & Upload Constraints
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760  # 10MB limit
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# 8. Observability & Production Logging
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"
